print("V.SALMAN")
import matplotlib.pyplot as plt

states = ["Sunny", "Cloudy", "Rainy"]

observations = ["Walk", "Shop", "Clean"]

start_probability = {
    "Sunny": 0.5,
    "Cloudy": 0.3,
    "Rainy": 0.2
}

transition_probability = {
    "Sunny": {
        "Sunny": 0.7,
        "Cloudy": 0.2,
        "Rainy": 0.1
    },
    "Cloudy": {
        "Sunny": 0.3,
        "Cloudy": 0.4,
        "Rainy": 0.3
    },
    "Rainy": {
        "Sunny": 0.2,
        "Cloudy": 0.3,
        "Rainy": 0.5
    }
}

emission_probability = {
    "Sunny": {
        "Walk": 0.6,
        "Shop": 0.3,
        "Clean": 0.1
    },
    "Cloudy": {
        "Walk": 0.3,
        "Shop": 0.4,
        "Clean": 0.3
    },
    "Rainy": {
        "Walk": 0.1,
        "Shop": 0.2,
        "Clean": 0.7
    }
}

# Viterbi algorithm
probability = {}
path = {}

for state in states:
    probability[state] = (
        start_probability[state] *
        emission_probability[state][observations[0]]
    )

    path[state] = [state]

for i in range(1, len(observations)):

    new_probability = {}
    new_path = {}

    for current_state in states:

        best_probability = 0
        best_previous = None

        for previous_state in states:

            p = (
                probability[previous_state]
                * transition_probability[previous_state][current_state]
                * emission_probability[current_state][observations[i]]
            )

            if p > best_probability:
                best_probability = p
                best_previous = previous_state

        new_probability[current_state] = best_probability
        new_path[current_state] = (
            path[best_previous] + [current_state]
        )

    probability = new_probability
    path = new_path

best_state = max(probability, key=probability.get)

predicted_sequence = path[best_state]

print("HIDDEN MARKOV MODEL - WEATHER PREDICTION")
print("----------------------------------------")
print("Observations:", observations)
print("Predicted Weather:", predicted_sequence)
print("Probability:", round(probability[best_state], 4))

# Draw HMM
plt.figure(figsize=(10, 6))

positions = {
    "Sunny": (1, 2),
    "Cloudy": (3, 2),
    "Rainy": (5, 2)
}

# Draw states
for state, (x, y) in positions.items():
    plt.scatter(x, y, s=3000)
    plt.text(
        x, y, state,
        ha="center",
        va="center",
        fontsize=12,
        fontweight="bold"
    )
for source in states:
    for target in states:

        if source != target:
            plt.annotate(
                "",
                xy=positions[target],
                xytext=positions[source],
                arrowprops=dict(
                    arrowstyle="->",
                    linewidth=1,
                    alpha=0.5
                )
            )

for i, state in enumerate(predicted_sequence):
    plt.text(
        positions[state][0],
        positions[state][1] - 0.7,
        "Observation: " + observations[i],
        ha="center",
        fontsize=10
    )

plt.title(
    "Hidden Markov Model\n"
    "Predicted: " + " → ".join(predicted_sequence),
    fontsize=14
)

plt.xlim(0, 6)
plt.ylim(0.5, 3)
plt.axis("off")
plt.show()
